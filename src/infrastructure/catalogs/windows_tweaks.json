  "tweaks": [
    {
      "id": "WPFTweaksRestorePoint",
      "name": "Criar Ponto de Restauração e Liberar Frequência",
      "category": "Tweaks Essenciais",
      "panel": "essential",
      "os_platform": "windows",
      "preset": "minimal",
      "risk_level": "safe",
      "requires_admin": true,
      "description": "Ajusta SystemRestorePointCreationFrequency = 0 para permitir múltiplos pontos de restauração no mesmo dia e cria um Ponto de Restauração imediato no Windows.",
      "benefit": "Garante rollback completo do Windows antes de qualquer alteração.",
      "undo_hint": "Restaura SystemRestorePointCreationFrequency para 1440 minutos (24h).",
      "registry_changes": [
        {
          "hive": "HKLM",
          "path": "SOFTWARE\\Microsoft\\Windows NT\\CurrentVersion\\SystemRestore",
          "name": "SystemRestorePointCreationFrequency",
          "type": "REG_DWORD",
          "value": 0,
          "original_value": 1440
        }
      ],
      "service_changes": [],
      "scheduled_tasks": [],
      "invoke_commands": [
        "powershell.exe -NoProfile -NonInteractive -Command \"Enable-ComputerRestore -Drive '$env:SystemDrive'; Checkpoint-Computer -Description 'LimpezaDesktop_PreOpt' -RestorePointType 'MODIFY_SETTINGS'\""
      ],
      "undo_commands": []
    },
